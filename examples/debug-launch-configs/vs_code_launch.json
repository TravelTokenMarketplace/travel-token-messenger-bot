{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{ // e2e
			"name": "e2e",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/tests/e2e/e2e_test.go",
			"buildFlags": [
				"-tags=e2e"
			],
			"args": [
				// "-test.parallel=8", // number of parallel test runs
				// "-existing-network-node-uri=127.0.0.1:19651", // local node endpoint, if need to use pre-existing local network
				// "-existing-network-admin-key=0x1111111111111111111111111111111111111111111111111111111111111111",
				"-anvil=${workspaceFolder}/build/dependencies/foundry/anvil", // path to anvil binary
				"-matrix=${workspaceFolder}/build/dependencies/camino-conduit/camino-conduit-v1.0.0/camino-conduit", // path to conduit binary
				//"-matrix=${workspaceFolder}/build/dependencies/camino-conduit/build/camino-conduit", // path to conduit binary if build locally
				// "-asb=${workspaceFolder}/build/dependencies/travel-token-matrix-app-service/build/travel-token-matrix-app-service", // path to travel-token-matrix-app-service if built locally
				"-partner-plugin=${workspaceFolder}/build/pp-mock", // path to partner-plugin binary
				"-ttmb=${workspaceFolder}/build/travel-token-messenger-bot", // path to ttmb binary
				"-tests-data-dir=/tmp/ttm-e2e", // path to e2e tests data directory
				"--filter=PingV1,TransportV3", // run specific tests. Will run all tests if not specified or empty
				"--debug" // enables verbose debug logging (including rpc requests and responses)
			]
		}
	]
}