<component name="ProjectRunConfigurationManager">
    <configuration default="false" name="e2e" type="GoTestRunConfiguration" factoryName="Go Test">
        <module name="travel-token-messenger-bot" />
        <working_directory value="$PROJECT_DIR$" />
        <go_parameters value="-tags=e2e" />
        <!--
          Run ./scripts/e2e.sh once first: it provisions build/dependencies/ and
          builds pp-mock and the bot, which this config only points at.

          The dependency paths below assume each dep was built from source. A
          dep that came down as a release tarball instead unpacks differently
          (camino-conduit v1.0.0, for one, lands in a versioned subdirectory:
          build/dependencies/camino-conduit/camino-conduit-v1.0.0/camino-conduit).
          Check the layout on disk and adjust if a path does not resolve.
        -->
        <parameters value="-test.parallel=4 -anvil=$PROJECT_DIR$/build/dependencies/foundry/anvil -matrix=$PROJECT_DIR$/build/dependencies/camino-conduit/build/camino-conduit -asb=$PROJECT_DIR$/build/dependencies/travel-token-matrix-app-service/build/travel-token-matrix-app-service -partner-plugin=$PROJECT_DIR$/build/pp-mock -ttmb=$PROJECT_DIR$/build/travel-token-messenger-bot -tests-data-dir=/tmp/ttm-e2e --debug" />
        <!-- envs for macOS:-->
        <envs>
            <env name="CGO_CFLAGS" value="-I/opt/homebrew/include" />
            <env name="CGO_LDFLAGS" value="-L/opt/homebrew/lib" />
        </envs>
        <kind value="FILE" />
        <package value="github.com/TravelTokenMarketplace/travel-token-messenger-bot/v13/tests/e2e" />
        <directory value="$PROJECT_DIR$" />
        <filePath value="$PROJECT_DIR$/tests/e2e/e2e_test.go" />
        <framework value="gotest" />
        <method v="2" />
    </configuration>
</component>